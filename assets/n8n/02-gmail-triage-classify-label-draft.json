    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a reply to this e-mail.\nFrom: {{ $('Gmail Trigger').item.json.from.value[0].name }}\nSubject: {{ $('Gmail Trigger').item.json.subject }}\n\n{{ ($('Gmail Trigger').item.json.text || '').slice(0, 3000) }}",
        "messages": {
          "messageValues": [
            {
              "message": "You write short, warm, professional replies for a service business. Thank them, answer what you can, propose a 15-minute call, sign off with the business name. Max 6 sentences, same language as the incoming e-mail. Plain text only."
            }
          ]
        }
      },

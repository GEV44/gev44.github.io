          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Analysis",
          "mode": "name"
        },
        "options": {}
      },
      "id": "8f12214c-34f0-5b51-9841-30c1704dcbef",
      "name": "Read Analysis",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        240,
        400
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const since = Date.now() - 7 * 24 * 3600 * 1000;\nconst rows = $input.all().map(i => i.json).filter(r => new Date(r.analysed_at).getTime() >= since);\nconst count = (key) => rows.reduce((a, r) => { a[r[key]] = (a[r[key]] || 0) + 1; return a; }, {});\nreturn [{ json: { total: rows.length, sentiment: count('sentiment'), topics: count('topic'), negatives: rows.filter(r => r.sentiment === 'negative').slice(0, 8).map(r => r.summary) } }];"
      },
      "id": "878e2f9e-d9c1-5365-9c9e-acf2e89ef3fa",
      "name": "Aggregate Last 7 Days",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        400
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify($json) }}",
        "messages": {
          "messageValues": [
            {
              "message": "You write a weekly customer-feedback summary for a business owner from aggregated stats. Give: overall mood in one line, top 2 recurring complaints, top 2 things customers like, and 2 concrete actions for next week. Max 900 characters, plain text."
            }
          ]
        }
      },

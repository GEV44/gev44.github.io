      "typeVersion": 3.4,
      "position": [
        500,
        0
      ]
    },
    {
      "parameters": {
        "resource": "sheet",
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Analysis",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "review": "={{ $json.review }}",
            "author": "={{ $json.author }}",
            "sentiment": "={{ $json.sentiment }}",
            "topic": "={{ $json.topic }}",
            "urgency": "={{ $json.urgency }}",
            "summary": "={{ $json.summary }}",
            "analysed_at": "={{ $json.analysed_at }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "4d3fbe69-bbf8-5e64-bebf-f33a7e3e187e",
      "name": "Save Analysis",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        740,
        0
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "fa43bd3a-ed1f-53f5-89d9-4b47520fb88d",
              "leftValue": "={{ $('Build Analysis Row').item.json.sentiment }}",
              "rightValue": "negative",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "ab7d748e-0bcf-54df-a57d-26a72c33500c",
              "leftValue": "={{ $('Build Analysis Row').item.json.urgency }}",
              "rightValue": "high",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "572e7a37-9ad8-5de0-a726-14c7da25a1aa",
      "name": "Urgent Negative?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        980,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=Unhappy customer\n{{ $('Build Analysis Row').item.json.author }}: {{ $('Build Analysis Row').item.json.summary }}\nTopic: {{ $('Build Analysis Row').item.json.topic }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "478069b6-4f96-57da-8dad-3ca70fbe53fd",
      "name": "Telegram Urgent Alert",

{
  "name": "06 Customer Review Analyzer - Sentiment, Topics, Weekly Summary",
  "nodes": [
    {
      "parameters": {
        "content": "Branch 1 analyses each new row of the Reviews sheet (columns: review, author, date). Branch 2 sends a weekly summary every Monday from the Analysis sheet. Set sheet IDs, credentials and chat ID.",
        "width": 520,
        "height": 200
      },
      "id": "59f9f476-a701-5e98-be6f-38313d7aa074",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        -260
      ]
    },
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Reviews",
          "mode": "name"
        },
        "event": "rowAdded",
        "options": {}
      },
      "id": "a1de7939-63a9-56d0-94e4-7566a2056622",
      "name": "New Review Row",
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.review }}",
        "messages": {
          "messageValues": [
            {
              "message": "You analyse customer reviews. Return sentiment (positive/neutral/negative), the main topic (one of: service, price, quality, delivery, staff, other), urgency (low/high; high only if the customer is upset and at risk of leaving) and a one-line summary in English."
            }
          ]
        },
        "hasOutputParser": true
      },
      "id": "68756bcd-6db4-594f-9528-9d1c43cb2242",
      "name": "Analyse Review",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list"
        },
        "options": {
          "temperature": 0.2
        }
      },
      "id": "a3df2339-24b3-5e24-8523-a4efc8b49502",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        240,
        220
      ],
      "credentials": {
        "openAiApi": {
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\n  \"sentiment\": \"negative\",\n  \"topic\": \"delivery\",\n  \"urgency\": \"high\",\n  \"summary\": \"Order arrived two days late\"\n}"
      },
      "id": "ef579f7b-d156-5086-8be3-225b5172e001",
      "name": "Review Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        420,
        220
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "d650636f-110d-5cb1-add2-55a5a6d08b3a",
              "name": "review",
              "value": "={{ $('New Review Row').item.json.review }}",
              "type": "string"
            },
            {
              "id": "b0ac68f9-b8a0-5569-acf7-2ca1efb749c1",
              "name": "author",
              "value": "={{ $('New Review Row').item.json.author }}",
              "type": "string"
            },
            {
              "id": "bed233ab-f5cd-532c-9c32-be47cbfcaebd",
              "name": "sentiment",
              "value": "={{ $json.output.sentiment }}",
              "type": "string"
            },
            {
              "id": "a431d259-1c40-5e1f-ba31-a8022e333e81",
              "name": "topic",
              "value": "={{ $json.output.topic }}",
              "type": "string"
            },
            {
              "id": "fdf7d5d9-c5c6-53ca-8348-31caa573fd67",
              "name": "urgency",
              "value": "={{ $json.output.urgency }}",
              "type": "string"
            },
            {

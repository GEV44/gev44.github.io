              "name": "summary",
              "value": "={{ $json.output.summary }}",
              "type": "string"
            },
            {
              "id": "aa7a93a9-ccf9-5906-afa8-024098eae269",
              "name": "analysed_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
